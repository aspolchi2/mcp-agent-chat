# Cadena de conexión de MongoDB Atlas (Vercel > Storage > MongoDB Atlas también la inyecta)
MONGODB_URI="mongodb+srv://usuario:password@cluster.mongodb.net/?retryWrites=true&w=majority"

# Nombre de la base de datos (opcional, por defecto: mcp_chat)
MONGODB_DB="mcp_chat"

# Token compartido opcional. Si lo defines, los clientes MCP deben enviar
# `Authorization: Bearer <token>`. Déjalo vacío sólo en local.
MCP_AUTH_TOKEN=""

# --- Login web (NextAuth + Google) ---

# Firma las cookies de sesión. Genera uno con: npx auth secret
AUTH_SECRET=""

# OAuth Client de Google Cloud Console (tipo "Web application").
# Redirect URIs autorizadas:
#   http://localhost:3000/api/auth/callback/google
#   https://<tu-dominio>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Quién puede entrar a la web NO es una variable de entorno: la lista está en
# `lib/allowed-emails.ts`. Para invitar a alguien, añade su mail ahí y despliega.
